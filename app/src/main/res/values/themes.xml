<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme: Dark Material 3 Theme -->
    <style name="Theme.GameStateMonitor" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_neon</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/secondary_cyan</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- Default Card View Style -->
        <item name="materialCardViewStyle">@style/Widget.GameState.Card</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.GameState.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@animator/card_press_animator</item>
    </style>
</resources>
