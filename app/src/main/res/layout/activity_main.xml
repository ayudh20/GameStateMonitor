<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ============================================================ -->
        <!-- HEADER SECTION: App Title with Glowing Dot & Subtitle         -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GameState Monitor"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/vHeaderStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_cyan" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.06"
            android:text="REAL-TIME PERFORMANCE DIAGNOSTICS"
            android:textColor="@color/figma_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ============================================================ -->
        <!-- CARD 1: DEVICE INFORMATION                                   -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerDeviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerIcon="@drawable/ic_device"
                    app:headerTitle="Device Information" />

                <!-- Key-Value Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- Model Name -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowDeviceModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowLabel="Model Name"
                        app:rowValue="ROG Phone 8 Pro" />

                    <!-- Android Version -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowDeviceAndroidVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Android Version"
                        app:rowValue="Android 14" />

                    <!-- Kernel Version -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowDeviceKernelVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Kernel Version"
                        app:rowValue="Linux 6.1" />

                    <!-- Active Diagnostic Run -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowActiveDiagnosticRun"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Active Diagnostic Run"
                        app:rowValue="00h 00m 00s"
                        app:rowValueColor="@color/figma_cyan" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 2: CPU PROCESSOR                                         -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with Prominent Metric -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerCpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndText="42% LOAD"
                    app:headerEndTextColor="@color/figma_cyan"
                    app:headerIcon="@drawable/ic_pulse"
                    app:headerTitle="CPU Processor" />

                <!-- Thin Sleek Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbCpuLoad"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="42"
                    android:progressDrawable="@drawable/progress_bar_figma" />

                <!-- Bottom Row: Chipset Name + Cores Active -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCpuName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="Snapdragon 8 Gen 3" />

                    <TextView
                        android:id="@+id/tvCpuCoresActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="8 Cores Active" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 3: GPU GRAPHICS                                          -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with Prominent Metric -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerGpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndText="58% UTIL"
                    app:headerEndTextColor="@color/figma_cyan"
                    app:headerIcon="@drawable/ic_bolt"
                    app:headerTitle="GPU Graphics" />

                <!-- Thin Sleek Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbGpuUtil"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="58"
                    android:progressDrawable="@drawable/progress_bar_figma" />

                <!-- Sub-row: Renderer + Frequency -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGpuRenderer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="Adreno 750 Core" />

                    <TextView
                        android:id="@+id/tvGpuFrequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="710 MHz" />
                </LinearLayout>

                <!-- Bottom row: Display Refresh Rate -->
                <com.gamestate.monitor.ui.KeyValueRowView
                    android:id="@+id/rowDisplayRefreshRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:rowLabel="Display Refresh Rate"
                    app:rowValue="60 Hz"
                    app:rowValueColor="@color/figma_cyan" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 4: FPS PERFORMANCE (Modular Engine)                      -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator"
            app:strokeColor="@color/figma_cyan"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header: Icon + Title + Live Status Badge -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndBadgeBackground="@drawable/bg_status_badge"
                    app:headerEndText="NO GAME"
                    app:headerEndTextColor="@color/figma_text_muted"
                    app:headerIcon="@drawable/ic_pulse"
                    app:headerTitle="FPS Performance" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Modular frame pacing architecture reading genuine SurfaceFlinger &amp; hardware timestamps with zero estimation."
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp" />

                <!-- FPS Status -->
                <com.gamestate.monitor.ui.KeyValueRowView
                    android:id="@+id/rowFpsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:rowLabel="FPS Status"
                    app:rowValue="No Game Detected"
                    app:rowValueColor="@color/white" />

                <!-- FPS Source -->
                <com.gamestate.monitor.ui.KeyValueRowView
                    android:id="@+id/rowFpsSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:rowLabel="FPS Source"
                    app:rowValue="SurfaceFlinger (ADB)"
                    app:rowValueColor="@color/figma_cyan" />

                <!-- Monitoring Availability -->
                <com.gamestate.monitor.ui.KeyValueRowView
                    android:id="@+id/rowFpsAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:rowLabel="Monitoring Availability"
                    app:rowValue="Requires ADB DUMP permission"
                    app:rowValueColor="@color/figma_text_muted" />

                <!-- Active Game -->
                <com.gamestate.monitor.ui.KeyValueRowView
                    android:id="@+id/rowActiveGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:rowLabel="Active Game"
                    app:rowValue="None Detected"
                    app:rowValueColor="@color/figma_cyan" />

                <!-- Frame Pacing & Diagnostics Sub-panel (Future-Ready) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_inner_container"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Real Pacing Metrics"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_figma_inactive"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Zero Fake Data"
                            android:textColor="@color/figma_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowCurrentFps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Real-Time FPS"
                        app:rowValue="Awaiting frames"
                        app:rowValueColor="@color/figma_text_muted" />

                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowTargetRefreshRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Target Display Refresh"
                        app:rowValue="60 Hz"
                        app:rowValueColor="@color/figma_cyan" />

                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowFrameTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Average Frame Time"
                        app:rowValue="Awaiting backend"
                        app:rowValueColor="@color/figma_text_muted" />

                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowOnePercentLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="1% Low FPS"
                        app:rowValue="Awaiting backend"
                        app:rowValueColor="@color/figma_text_muted" />

                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowDroppedFrames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Dropped Frames"
                        app:rowValue="0 (Awaiting backend)"
                        app:rowValueColor="@color/figma_text_muted" />
                </LinearLayout>

                <!-- Action Button for Granting Usage Access or Copying ADB -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFpsAction"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:padding="0dp"
                    android:text="Enable Game Detection (Usage Access)"
                    android:textColor="@color/figma_cyan"
                    android:textSize="12sp"
                    app:strokeColor="@color/figma_cyan" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 5: RAM MEMORY                                            -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerIcon="@drawable/ic_database"
                    app:headerTitle="RAM Memory" />

                <!-- Sub-row: Used / Total on Left, % on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRamUsageValues"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Used: 4.6 GB / Total: 5.4 GB" />

                    <TextView
                        android:id="@+id/tvRamPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/figma_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="85%" />
                </LinearLayout>

                <!-- Thin Sleek Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbRamUsage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="85"
                    android:progressDrawable="@drawable/progress_bar_figma" />

                <!-- Bottom row: Available -->
                <TextView
                    android:id="@+id/tvRamAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp"
                    tools:text="Available: 829.9 MB" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 5: BATTERY HEALTH & THERMALS                             -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerIcon="@drawable/ic_trending_up"
                    app:headerTitle="Battery Health &amp; Thermals" />

                <!-- Metrics Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <!-- Row 1: Battery Level -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowBatteryLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowLabel="Battery Level"
                        app:rowValue="85% (Discharging)"
                        app:rowValueColor="@color/figma_green_health" />

                    <!-- Row 2: Battery Temperature -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowBatteryTemp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Battery Temperature"
                        app:rowValue="38.5 °C"
                        app:rowValueColor="@color/figma_amber_temp" />

                    <!-- Row 3: CPU Temperature (if available) -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowCpuTemp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="CPU Temperature"
                        app:rowValue="42.0 °C"
                        app:rowValueColor="@color/white" />

                    <!-- Row 4: Thermal Status (Color Coded: Normal, Warm, Hot, Critical) -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowThermalStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Thermal Status"
                        app:rowValue="Normal"
                        app:rowValueColor="@color/thermal_normal" />

                    <!-- Row 5: Charge Voltage -->
                    <com.gamestate.monitor.ui.KeyValueRowView
                        android:id="@+id/rowBatteryVoltage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:rowLabel="Charge Voltage"
                        app:rowValue="4.12 V"
                        app:rowValueColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 7: INTERNAL STORAGE                                      -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with Prominent Metric -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndText="87% USED"
                    app:headerEndTextColor="@color/figma_cyan"
                    app:headerIcon="@drawable/ic_folder"
                    app:headerTitle="Internal Storage" />

                <!-- Thin Sleek Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbStorageUsage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="87"
                    android:progressDrawable="@drawable/progress_bar_figma" />

                <!-- Bottom row: Used / Total on Left, Free on Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStorageUsageValues"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="Used: 112 GB / 128 GB" />

                    <TextView
                        android:id="@+id/tvStorageAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp"
                        tools:text="16 GB Free" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 8: FLOATING GAMING OVERLAY HUD                           -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/card_press_animator"
            app:strokeColor="@color/figma_cyan"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row: Display Icon + Title + Status Badge -->
                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndBadgeBackground="@drawable/bg_status_badge"
                    app:headerEndText="INACTIVE"
                    app:headerEndTextColor="@color/figma_cyan"
                    app:headerIcon="@drawable/ic_display"
                    app:headerTitle="Floating Gaming HUD" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Display real-time CPU % and GPU info alongside RAM and Thermals as a draggable HUD floating over any game."
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Launch Gaming Overlay"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/figma_cyan"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_display"
                    app:iconGravity="textStart"
                    app:iconTint="@color/black" />

                <!-- Enhanced FPS Detection & ADB Unlock -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_inner_container"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvDumpStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enhanced FPS Detection"
                        android:textColor="@color/figma_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDumpHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Enable advanced game performance monitoring through ADB."
                        android:textColor="@color/figma_text_muted"
                        android:textSize="10sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyAdbCommand"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:padding="0dp"
                        android:text="Copy ADB Unlock Command"
                        android:textColor="@color/figma_cyan"
                        android:textSize="11sp"
                        app:strokeColor="@color/figma_cyan" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- ACTION BUTTON: REFRESH STATISTICS                             -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Refresh Statistics"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/figma_cyan"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconTint="@color/black" />

        <TextView
            android:id="@+id/tvAutoRefreshNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Auto-refreshes every 2 seconds"
            android:textColor="@color/figma_text_muted"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
