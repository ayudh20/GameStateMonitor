<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_bg_dark"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Service"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.06"
            android:text="SHIZUKU BACKEND &amp; APP PREFERENCES"
            android:textColor="@color/figma_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- SHIZUKU & PRIVILEGED BACKEND CARD -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.gamestate.monitor.ui.CardHeaderView
                    android:id="@+id/headerShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerEndBadgeBackground="@drawable/bg_status_badge"
                    app:headerEndText="AUTHORIZED"
                    app:headerEndTextColor="@color/status_optimal"
                    app:headerIcon="@drawable/ic_bolt"
                    app:headerTitle="Shizuku Privileged IPC" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Shizuku grants non-root access to SurfaceFlinger framebuffers and dumpsys telemetry for hardware-accurate 60/90/120 FPS tracking."
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckShizuku"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Verify Shizuku Permission"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/figma_cyan"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyAdbCommandSettings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="Copy ADB Unlock Command"
                    android:textColor="@color/figma_cyan"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/figma_cyan" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MONITORING PREFERENCES CARD -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.gamestate.monitor.ui.CardHeaderView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerIcon="@drawable/ic_device"
                    app:headerTitle="Monitoring Behavior" />

                <!-- Telemetry Update Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Telemetry Update Interval"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgUpdateInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbInterval1s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/figma_cyan"
                        android:text="1.0s (Fast)"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbInterval15s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/figma_cyan"
                        android:checked="true"
                        android:text="1.5s (Norm)"
                        android:textColor="@color/figma_cyan"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbInterval2s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/figma_cyan"
                        android:text="2.0s (Save)"
                        android:textColor="@color/figma_text_muted"
                        android:textSize="12sp" />
                </RadioGroup>

                <!-- Keep Screen Awake Switch -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeepScreenOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="Keep Screen Awake in App"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- Auto-hide overlay on game exit -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoHideOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="false"
                    android:text="Auto-hide Overlay on Game Exit"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- APP INFO & RESET -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GameState.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.gamestate.monitor.ui.CardHeaderView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:headerIcon="@drawable/ic_device"
                    app:headerTitle="About GameState Monitor" />

                <TextView
                    android:id="@+id/tvAboutAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GameState Monitor v1.1.0\nPure Android Hardware Telemetry Engine\nZero fake data • Direct SurfaceFlinger integration"
                    android:textColor="@color/figma_text_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetAllSettings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:text="Reset All Settings to Defaults"
                    android:textColor="@color/status_high_load"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/status_high_load" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
