<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/cardHeaderIconContainer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_badge_squircle">

        <ImageView
            android:id="@+id/cardHeaderIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Card Icon"
            android:src="@drawable/ic_device"
            app:tint="@color/figma_cyan" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Card Title" />

    <TextView
        android:id="@+id/cardHeaderEndText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/figma_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="42% LOAD"
        tools:visibility="visible" />

</merge>
